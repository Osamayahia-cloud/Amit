   "source": [
    "enmassage = \"##$$$@!yalpstcejorp EPUVT****9887\"\n",
    "\n",
    "start = enmassage.find(\"!\") + 1\n",
    "end = enmassage.find(\"*\")\n",
    "\n",
    "en = enmassage[start:end]\n",
    "\n",
    "rev = en.split()\n",
    "\n",
    "first = rev[0][::-1]\n",
    "\n",
    "second = rev[1].replace(\"E\", \"A\").replace(\"U\", \"O\")\n",
    "\n",
    "print(first, second)"
   ]
